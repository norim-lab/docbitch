# Railway Environment Variables Template
# Copy these to your Railway service settings

# Server Configuration
PORT=3001
NODE_ENV=production

# Database Configuration
# Railway automatically provides these as MYSQLHOST, MYSQLPORT, etc.
# The backend will automatically use Railway's MySQL variables
# But you can also set custom mappings:
DB_HOST=${{MYSQLHOST}}
DB_PORT=${{MYSQLPORT}}
DB_USER=${{MYSQLUSER}}
DB_PASSWORD=${{MYSQLPASSWORD}}
DB_NAME=${{MYSQLDATABASE}}

# File Upload Configuration
UPLOAD_DIR=/tmp/uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=.pdf,.jpg,.jpeg,.png,.gif,.txt,.doc,.docx

# CORS Configuration
# Set to your frontend URL after deployment
CORS_ORIGIN=*
# Or specific domain: CORS_ORIGIN=https://your-frontend.vercel.app
